{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "functions": {
    "api/assistant.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/commande.js": {
      "maxDuration": 60
    },
    "api/planning-reader.js": {
      "maxDuration": 60
    },
    "api/notifications.js": {
      "maxDuration": 60
    },
    "api/notification-cron.js": {
      "maxDuration": 60
    },
    "api/retention-cron.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/retention-cron",
      "schedule": "0 3 * * *"
    }
  ],
  "fluid": true
}
